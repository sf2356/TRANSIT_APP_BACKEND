# Copier en .env et renseigner des valeurs réelles — ne JAMAIS committer .env
SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8080

DB_URL=jdbc:postgresql://localhost:5432/transit_platform
DB_USERNAME=transit_app
DB_PASSWORD=changeme
DB_POOL_SIZE=10

JWT_SECRET=change-me-to-a-random-secret-of-at-least-256-bits-before-any-real-use
JWT_ACCESS_EXPIRATION_MINUTES=30
JWT_REFRESH_EXPIRATION_DAYS=14

CORS_ALLOWED_ORIGINS=http://localhost:4200

STORAGE_PROVIDER=local
STORAGE_LOCAL_PATH=./storage
# Renseigner uniquement si STORAGE_PROVIDER=s3 (AWS S3, Cloudflare R2 ou MinIO) :
STORAGE_S3_ENDPOINT=
STORAGE_S3_BUCKET=
STORAGE_S3_REGION=
STORAGE_S3_ACCESS_KEY=
STORAGE_S3_SECRET_KEY=

UPLOAD_MAX_FILE_SIZE=25MB
UPLOAD_MAX_REQUEST_SIZE=25MB
