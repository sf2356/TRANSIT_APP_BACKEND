# Prompt 08 §52 : reverse proxy HTTPS devant Angular (statique) + Spring Boot (API).
# Ce fichier est un TEMPLATE — remplacer <DOMAINE>, <CHEMIN_ANGULAR_DIST> et les chemins
# de certificats avant usage réel. Non testé en conditions réelles (aucun serveur
# disponible dans cet environnement de développement) — à valider avant mise en production.

server {
    listen 80;
    server_name <DOMAINE>;
    # Redirection systématique vers HTTPS (Prompt 08 §50 : HTTPS obligatoire en production).
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    server_name <DOMAINE>;

    ssl_certificate     /etc/letsencrypt/live/<DOMAINE>/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/<DOMAINE>/privkey.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;

    # Frontend Angular (build de production statique, Prompt 05 §79)
    root <CHEMIN_ANGULAR_DIST>;
    index index.html;

    location / {
        try_files $uri $uri/ /index.html;  # nécessaire pour le routing Angular (SPA)
    }

    # API backend Spring Boot — jamais exposée directement sur Internet sans ce proxy
    location /api/ {
        proxy_pass http://127.0.0.1:8080/api/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        client_max_body_size 25M;  # cohérent avec UPLOAD_MAX_FILE_SIZE backend (Prompt 04 §43)
    }

    # Health check accessible uniquement en interne si possible (Prompt 08 §53) — restreindre
    # par IP si le monitoring n'est pas exposé publiquement.
    location /actuator/health {
        proxy_pass http://127.0.0.1:8080/actuator/health;
    }
}
